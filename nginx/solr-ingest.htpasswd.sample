# Copy to nginx/solr-ingest.htpasswd, or fill nginx/ from Vault (secret/progressx/NginxFileConfig):
#   python3 ci/vault-fetch.py files progressx/NginxFileConfig nginx
# Password for nginx's /solr-ingest/ route (the weekly ETL writes to Solr through it). One line,
# user:hash. Make one with: printf 'github-actions:%s\n' "$(openssl passwd -apr1)"
# (keep the password: it also goes in solr-ingest-url.txt). Lines starting with # are ignored.
github-actions:$apr1$replace$withYourOwnHashFromOpensslPasswd
