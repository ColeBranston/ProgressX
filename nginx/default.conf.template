# ---------- Real client IP ----------
# Traffic arrives through the Cloudflare Tunnel (cloudflared on this machine, seen as the
# Docker Desktop gateway) or straight from Cloudflare's edge. For those sources only, use the
# visitor's IP from CF-Connecting-IP so rate limits apply per visitor, not to Cloudflare as a whole.
# Anyone else connecting directly keeps their own address and can't spoof the header.
# Cloudflare ranges from https://www.cloudflare.com/ips (fetched 2026-09-27)
set_real_ip_from 192.168.65.0/24;
set_real_ip_from 127.0.0.1;
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# ---------- API rate limits (per visitor IP) ----------
# Each tier allows a short burst, then the steady rate; anything beyond gets a 429.
limit_req_zone $binary_remote_addr zone=api_auth:10m rate=10r/m;    # 1 per 6s: login / signup (password guessing)
limit_req_zone $binary_remote_addr zone=api_upload:10m rate=30r/m;  # 1 per 2s: photo uploads (Cloudinary cost)
limit_req_zone $binary_remote_addr zone=api_search:10m rate=2r/s;   # search (Solr queries)
limit_req_zone $binary_remote_addr zone=api_general:10m rate=5r/s;  # every other /api route
limit_req_zone $binary_remote_addr zone=solr_ingest:10m rate=20r/s;  # GitHub Actions Solr ingestion (/solr-ingest/)
limit_req_status 429;
limit_req_log_level warn;

# ---------- One public address: https://progressx.ca ----------
# Cloudflare tells us how the visitor arrived (CF-Visitor / X-Forwarded-Proto). Plain http:// and the
# www. host get a permanent redirect to https://progressx.ca, so Google indexes one copy of each page.
# Requests that don't come through Cloudflare (local checks on this machine) are left alone.
map $http_cf_visitor $visitor_scheme {
    default                  "";
    "~\"scheme\":\"http\""  "http";
    "~\"scheme\":\"https\"" "https";
}

map "$visitor_scheme|$http_x_forwarded_proto|$host" $canonical_redirect {
    default                    0;
    "~^http\|"                 1;  # visitor used http://
    "~^\|http\|"               1;  # no CF-Visitor, but the edge says http
    "~\|www\.progressx\.ca$"   1;  # www. host
}

server {
    listen 80;

    if ($canonical_redirect) {
        return 301 https://progressx.ca$request_uri;
    }

    # Re-resolve the app container through Docker's DNS instead of once at startup,
    # so rebuilding the app (which can change its IP) doesn't leave nginx pointing at a dead address
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $frontend ${FRONTEND_URL};
    set $solr ${SOLR_ORIGIN};

    # nginx defaults to 1 MB; phone photos are larger (the app caps uploads at 10 MB)
    client_max_body_size 12m;

    # inherited by every location below
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    error_page 429 = @rate_limited;

    location @rate_limited {
        default_type application/json;
        add_header Retry-After 2 always;
        return 429 '{"message":"Too many requests. Please slow down and try again in a moment."}';
    }

    location ~ ^/api/auth/(login|signup)(/|$) {
        limit_req zone=api_auth burst=5 nodelay;
        proxy_pass $frontend;
    }

    location ~ ^/api/user/userImages/upload {
        limit_req zone=api_upload burst=3 nodelay;
        proxy_pass $frontend;
    }

    location /api/search/ {
        limit_req zone=api_search burst=10 nodelay;
        proxy_pass $frontend;
    }

    location /api/ {
        limit_req zone=api_general burst=30 nodelay;
        proxy_pass $frontend;
    }

    # ---------- Solr ingestion for the GitHub Actions ETL (.github/workflows/schedule.yml) ----------
    # Point the SOLR_PROD_URL secret at https://github-actions:<password>@progressx.ca/solr-ingest/
    # (the full value is in nginx/solr-ingest-url.txt, which is gitignored). pysolr/requests send the
    # user:password from the URL as HTTP Basic auth, so the workflow code doesn't change.
    # Only the two ingestion cores' select + update handlers are reachable; everything else in Solr
    # (admin, config, other cores) stays private.
    location ^~ /solr-ingest/ {
        auth_basic "ProgressX Solr ingestion";
        auth_basic_user_file /etc/nginx/solr-ingest.htpasswd;
        limit_req zone=solr_ingest burst=100 nodelay;

        # the clean migration sends/reads 20,000 documents per request
        client_max_body_size 100m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        location ~ ^/solr-ingest/(raw_ingestion_data|clean_ingestion_data)/(select|update)/?$ {
            limit_except GET POST {
                deny all;
            }

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Authorization "";  # Solr itself has no auth; don't forward the credentials

            rewrite ^/solr-ingest/(.*)$ /solr/$1 break;
            proxy_pass $solr;
        }

        return 404;
    }

    location / {
        proxy_pass $frontend;
    }
}
