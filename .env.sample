# Ports each service listens on (also published on this machine)
NGINX_PORT=80
FRONTEND_PORT=8080
SEARCH_BACKEND_PORT=8000
SOLR_PORT=8983
REDIS_PORT=6379

# URLs containers use to reach each other (service names resolve on the compose network)
FRONTEND_URL=http://progressx:8080
SEARCH_BACKEND_URL=http://search_backend:8000
SOLR_URL=http://solr:8983/solr/
# Solr host for nginx's /solr-ingest/ route (no /solr path)
SOLR_ORIGIN=http://solr:8983
REDIS_URL=redis://redis:6379/0

# Public URL the browser uses to reach the app (Supabase OAuth redirects back here)
APP_URL=http://localhost

# How long search results / single documents stay cached in Redis
SEARCH_CACHE_TTL_SECONDS=3600
DOC_CACHE_TTL_SECONDS=86400
