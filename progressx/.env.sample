# App secrets and settings. Copy to .env.local and fill in. What each one means: docs/operations.md
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# search backend (FastAPI -> Solr), read at runtime by /api/search
SEARCH_BACKEND_URL=http://localhost:8000
APP_URL=http://localhost:3001

# diet assistant: local Ollama + the foods Solr core (Docker sets these from the root .env),
# and optionally Google AI Overview lookups via SerpApi for foods the database doesn't have
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=gemma4:e2b
FOODS_SOLR_URL=http://localhost:8983/solr/foods
SERPAPI_API_KEY=

# videos (For You feed, profile uploads): a private Cloudflare R2 bucket. Leave empty to turn uploads off.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_VIDEO_BUCKET=progressx-videos

# government ID verification (see docs/operations.md "ID verification"). Generate keys with: openssl rand -base64 32
ID_ENCRYPTION_KEY=
ID_ENCRYPTION_KEY_VERSION=1
ID_FINGERPRINT_KEY=
R2_ID_BUCKET=progressx-ids
R2_ID_ACCESS_KEY_ID=
R2_ID_SECRET_ACCESS_KEY=
