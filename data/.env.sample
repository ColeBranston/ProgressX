# Search backend and ingestion DAGs run outside Docker (in Docker, compose sets these). Copy to data/.env.
# Not in Vault as its own secret: solr_prod_url is the value of solr-ingest-url.txt in
# secret/progressx/NginxFileConfig. What each one means: docs/operations.md ("3. data/.env").

# local = solr_local_url, prod = solr_prod_url
python_backend_env=local
solr_local_url=http://localhost:8983/solr/
# https://github-actions:<password>@progressx.ca/solr-ingest/ (only needed with python_backend_env=prod)
solr_prod_url=

# search backend's Redis cache (leave REDIS_URL empty to run without a cache)
REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL_SECONDS=3600
DOC_CACHE_TTL_SECONDS=86400
